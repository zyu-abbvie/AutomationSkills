#!/usr/bin/env python3
"""init-config - write a clean automation.local.yaml, seeded from what you already have.

The estate's doc/credential.yaml grew organically: mixed section shapes, bare `host:port` lines
that are not really key/value pairs, and settings no tool reads. This produces one structured file
covering both environments, and fills in whatever it can find from credential.yaml and the
environment so you are not retyping connection details.

    init-config                  # write ./automation.local.yaml (refuses to clobber)
    init-config --force          # overwrite an existing file
    init-config --stdout         # print it instead, with secrets masked
    init-config -o <path>

Secret values are written into the file (that is what the file is for, and it is gitignored) but
are never printed to the terminal.
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import _config  # noqa: E402

PLUGIN = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
REPO = os.path.dirname(os.path.dirname(PLUGIN))

TEMPLATE = """\
# automation-engineering - local configuration
#
# Generated by bin/init-config. Gitignored: this file holds credentials and must never be
# committed. The committed template is automation.local.example.yaml.
#
# Precedence, highest first:  command-line flag > environment variable > this file > built-in default
# Check what actually resolved, with secrets masked:
#
#     {plugin_rel}/bin/ign config
#     {plugin_rel}/bin/ign config --env prod
#
# Select an environment per command with --env dev / --env prod, or export AUTOMATION_ENV.
# Any value may indirect through the environment: api_token: ${{IGNITION_TOKEN}}

# --------------------------------------------------------------------------------------------
# Global
# --------------------------------------------------------------------------------------------

# Hosts treated as production. The bundled tools refuse to send writes to these, and the
# PreToolUse hook asks before any command that names one.
prod_hosts: {prod_hosts}

# Where the on-disk reference material lives. Leave empty if doc/ sits beside this file.
# Teammates who clone without doc/ can point these at a share instead of symlinking.
backups_dir: {backups_dir}
nodered_backups_dir: {nodered_backups_dir}

# --------------------------------------------------------------------------------------------
# dev - Ignition 8.3.7 on {dev_host}
#   Has the HTTP API and the MCP server. API reads are anonymous; writes need api_token.
#   Broker carries bench and training traffic only - no field device publishes here, so do not
#   use it to decide whether equipment is alive.
# --------------------------------------------------------------------------------------------
dev:
  gateway_url: {dev_gateway_url}

  # Needed for API WRITES and for every MCP tool (searchPitfalls, addPitfall, readTags, ...).
  # Create one in the Gateway: Config > Security > API Tokens.
  api_token: {dev_api_token}
  mcp_server: {mcp_server}

  mqtt_host: {dev_mqtt_host}
  mqtt_port: {dev_mqtt_port}
  mqtt_username: {dev_mqtt_username}
  mqtt_password: {dev_mqtt_password}
  mqtt_keepalive: {dev_mqtt_keepalive}
  mqtt_tls: {dev_mqtt_tls}

  # Informational: there is no SQL Server driver on most hosts here, so the tools route SQL
  # through Ignition (a named query, or the MCP evalScript / queryTagHistory tools).
  sql_server: {dev_sql_server}
  sql_database: {dev_sql_database}
  sql_uid: {dev_sql_uid}
  sql_password: {dev_sql_password}

# --------------------------------------------------------------------------------------------
# prod - Ignition 8.1.28 on {prod_host}
#   NO HTTP API at all: every /data/api/v1 route returns 404, and there is no MCP server.
#   Inspect it through a gateway backup on disk; change it in the Designer.
#   The broker here is where every groov RIO field device actually publishes.
# --------------------------------------------------------------------------------------------
prod:
  gateway_url: {prod_gateway_url}

  # Nothing to authenticate to - leave empty.
  api_token: ""

  mqtt_host: {prod_mqtt_host}
  mqtt_port: {prod_mqtt_port}
  mqtt_username: {prod_mqtt_username}
  mqtt_password: {prod_mqtt_password}
  mqtt_keepalive: {prod_mqtt_keepalive}
  mqtt_tls: {prod_mqtt_tls}

  sql_server: {prod_sql_server}
  sql_database: {prod_sql_database}
  sql_uid: {prod_sql_uid}
  sql_password: {prod_sql_password}
"""


def quote(value):
    """Quote anything YAML would misread; normalise booleans to lowercase."""
    if isinstance(value, bool):
        return "true" if value else "false"
    s = "" if value is None else str(value)
    if s in ("True", "False"):
        return s.lower()
    if s == "":
        return '""'
    if s[0] in "{}[]&*!|>%@`#'\"" or ":" in s or "#" in s or s != s.strip():
        return '"%s"' % s.replace('"', '\\"')
    return s


def main():
    ap = argparse.ArgumentParser(prog="init-config", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-o", "--output", default=os.path.join(REPO, "automation.local.yaml"))
    ap.add_argument("--force", action="store_true", help="overwrite an existing file")
    ap.add_argument("--stdout", action="store_true", help="print with secrets masked, write nothing")
    args = ap.parse_args()

    dev, _dw, src = _config.load(env="dev")
    prod, _pw, _ = _config.load(env="prod")

    doc_dir = os.path.join(REPO, "doc")
    have_doc = os.path.isdir(doc_dir)

    def host_of(url):
        return url.split("//")[-1].split(":")[0] or "?"

    fields = {
        "plugin_rel": os.path.relpath(PLUGIN, REPO),
        "prod_hosts": quote(dev["prod_hosts"]),
        "mcp_server": quote(dev["mcp_server"]),
        "backups_dir": quote("" if have_doc else dev["backups_dir"]),
        "nodered_backups_dir": quote("" if have_doc else dev["nodered_backups_dir"]),
        "dev_host": host_of(dev["gateway_url"]),
        "prod_host": host_of(prod["gateway_url"]) if prod["gateway_url"] != dev["gateway_url"]
                     else (dev["prod_hosts"].split(",")[0] or "?"),
    }
    for envname, cfg in (("dev", dev), ("prod", prod)):
        for key in ("gateway_url", "api_token", "mqtt_host", "mqtt_port", "mqtt_username",
                    "mqtt_password", "mqtt_keepalive", "mqtt_tls",
                    "sql_server", "sql_database", "sql_uid", "sql_password"):
            fields["%s_%s" % (envname, key)] = quote(cfg.get(key, ""))

    # If credential.yaml carried no Ignition host for prod, fall back to the known prod hostname
    # rather than emitting the dev URL twice - that would silently point prod tooling at dev.
    if prod["gateway_url"] == dev["gateway_url"]:
        first_prod = dev["prod_hosts"].split(",")[0].strip()
        if first_prod:
            fields["prod_gateway_url"] = quote("http://%s:8088" % first_prod)
            fields["prod_host"] = first_prod

    text = TEMPLATE.format(**fields)

    if args.stdout:
        import re
        for key in ("api_token", "mqtt_password", "sql_password"):
            text = re.sub(r"(?m)^(\s*%s:\s*).*$" % key, r"\1<masked>", text)
        sys.stdout.write(text)
        return 0

    if os.path.exists(args.output) and not args.force:
        sys.stderr.write("init-config: %s already exists. Re-run with --force to overwrite.\n"
                         % args.output)
        return 1

    with open(args.output, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(args.output, 0o600)

    filled = sum(1 for k, v in fields.items()
                 if k.endswith(("password", "api_token", "uid")) and v not in ('""', ""))
    sys.stderr.write("wrote %s (mode 600)\n" % args.output)
    sys.stderr.write("seeded from %s\n" % (src or "built-in defaults only"))
    sys.stderr.write("%d credential field(s) populated; review the file and fill any that are empty\n"
                     % filled)
    sys.stderr.write("verify with: %s/bin/ign config\n" % os.path.relpath(PLUGIN, os.getcwd()))
    return 0


if __name__ == "__main__":
    sys.exit(main())
